FROM rust:alpine3.23

# Install jq (for libs.sh), python3 (for the Celery worker), and curl + unzip (for Deno install)
RUN apk add --no-cache jq python3 py3-pip curl unzip zip

WORKDIR /build

# Copy parsers.json, utils, and parser files
COPY parsers/parsers.json /parsers/
COPY parsers/utils/* /parsers/
COPY parsers/rust/*.rs /parsers/rust/

# Make utils executable
RUN chmod +x /parsers/extractor.sh && \
    chmod +x /parsers/libs.sh

# Dependency pinning and build
RUN for f in /parsers/rust/*.rs; do \
        stem=$(basename "$f" .rs | cut -d'-' -f2-); \
        id="rust-$stem"; \
        library=$(sh /parsers/extractor.sh "$id" library); \
        version=$(sh /parsers/extractor.sh "$id" version); \
        \
        echo "Building $library $version"; \
        \
        cargo init --name "$id"; \
        mv "$f" src/main.rs; \
        cargo add "$library@$version"; \
        extra_deps=$(sh /parsers/extractor.sh "$id" extra_deps); \
        if [ -n "$extra_deps" ] && [ "$extra_deps" != "null" ]; then \
            for dep in $extra_deps; do cargo add "$dep"; done; \
        fi; \
        cargo add "serde_json@1.0.149"; \
        cargo build --release; \
        \
        cp target/release/$id /parsers/rust/$(basename "$f" .rs); \
        zip /parsers/rust/$(basename "$f" .rs).zip src/main.rs Cargo.toml Cargo.lock; \
        rm -rf src target Cargo.toml Cargo.lock; \
    done

# Save the libs to a file for the worker to read
RUN /parsers/libs.sh rust > /parsers/worker_parsers.json

# Set up the worker
WORKDIR /app
COPY distributed/requirements.txt /app/
RUN pip3 install -r requirements.txt --break-system-packages
COPY distributed/core/ /app/core/
COPY distributed/registry/ /app/registry/
COPY distributed/tasks/ /app/tasks/
COPY distributed/worker.py /app/

CMD ["python3", "worker.py"]
